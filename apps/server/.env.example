# Local development: rendered files are stored in apps/server/storage and served
# from http://localhost:3001/files. Set true only when S3 is configured.
USE_AWS=false
LOCAL_STORAGE_DIR=storage
PUBLIC_BASE_URL=http://localhost:3001

# Groq is OpenAI-compatible, but development uses this key and not OPENAI_API_KEY.
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Database configuration
DATABASE_URL=

# Required only when USE_AWS=true
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
